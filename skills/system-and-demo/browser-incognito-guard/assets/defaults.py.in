#!/usr/bin/env python3
# Managed by browser-incognito-guard
"""Require the browser guard for supported incognito enable commands."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


GUARDS = __GUARDS__


def guarded_domain(arguments: list[str]) -> str | None:
    args = arguments
    if args[:1] == ["-currentHost"]:
        args = args[1:]
    elif args[:1] == ["-host"]:
        args = args[2:]
    if len(args) < 2:
        return None
    action, domain, *values = args
    if domain not in GUARDS:
        return None
    if action == "import":
        return domain
    if action == "delete":
        return domain if not values or values[0] == "IncognitoModeAvailability" else None
    if action != "write" or not values:
        return None
    # Whole-domain replacement can remove the policy along with other settings.
    if len(values) == 1:
        return domain
    if values[0] != "IncognitoModeAvailability":
        return None
    # Only an explicit integer disabling incognito is safe without verification.
    if len(values) == 3 and values[1] in ("-int", "-integer"):
        try:
            if int(values[2], 10) == 1:
                return None
        except ValueError:
            pass
    return domain


def main() -> int:
    arguments = sys.argv[1:]
    domain = guarded_domain(arguments)
    if domain is not None:
        guard = Path(__file__).resolve().parent / GUARDS[domain]
        result = subprocess.run([str(guard), "gate"], check=False)
        if result.returncode != 0:
            return result.returncode

    os.execv("/usr/bin/defaults", ["defaults", *arguments])
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
